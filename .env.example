# Скопируйте в .env и снимите «#» только с нужных строк: пустое значение — это ошибка, а не значение по умолчанию.
# Код сам читает из .env только голос роликов. Запуск: uv run --env-file .env glava build <глава>
# Файл .env в git не попадает (.gitignore).

# Провайдер модели: claude_code (по умолчанию), anthropic, openai или local
# LLM_PROVIDER=

# Имя модели. По умолчанию алиас sonnet; для anthropic нужно полное имя
# LLM_MODEL=

# Путь к claude.exe, если команды claude нет в PATH (только claude_code)
# CLAUDE_EXE=

# Потолок расхода одного запуска в долларах по прайсу, по умолчанию 25
# GLAVA_BUDGET_USD=

# Ключ API (только anthropic)
# ANTHROPIC_API_KEY=

# Ключ API (только openai)
# OPENAI_API_KEY=

# Сервер с API OpenAI (только local): по умолчанию Ollama, http://127.0.0.1:11434/v1; ключ — если сервер его требует
# LLM_BASE_URL=
# LLM_API_KEY=

# Размер контекста локальной модели, токены: по нему ловится обрезка запроса
# LLM_CONTEXT=

# Цена, доллары за миллион токенов: обязательна для openai и для local на другом компьютере
# LLM_PRICE_IN=
# LLM_PRICE_OUT=

# ---------- Голос роликов. Эти строки (VOICE_*, ELEVENLABS_*) код читает из .env сам.
# Ключ и голос ElevenLabs; список голосов: glava voices
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Голос: elevenlabs или edge (Microsoft). Без строки — elevenlabs, если есть ключ
# VOICE_PROVIDER=

# Запасной голос: если основной отказал, он озвучит ролик целиком
# VOICE_FALLBACK=edge

# Модель и манера: темп 0.7–1.2 (v3 и v4 темпа не знают), остальное 0–1; знаки ударения можно отключить нулём
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_SPEED=0.95
# ELEVENLABS_STABILITY=0.6
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0
# ELEVENLABS_SEED=7
# ELEVENLABS_STRESS=1

# Потолок платных знаков на ролик; цена за тысячу знаков нужна только отчёту process
# ELEVENLABS_MAX_CHARS=6000
# ELEVENLABS_USD_PER_1K=
